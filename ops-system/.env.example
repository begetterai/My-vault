# ── обязательные ─────────────────────────────────────────────────────────────
BOT_TOKEN=            # токен бота от @BotFather — ОТДЕЛЬНЫЙ, не личный
DATA_SHEET=           # id таблицы операционных данных
GOOGLE_SA_JSON=       # сервисный аккаунт Google, JSON одной строкой

# ── желательные ──────────────────────────────────────────────────────────────
ADMIN_CHAT=           # chat_id того, кому идут сводки (COO)
PHOTO_FOLDER=         # id папки Drive под фото
WEBAPP_URL=           # адрес Mini App, напр. https://xxx.up.railway.app
GOOGLE_SUBJECT=       # если сервисный аккаунт работает от имени пользователя
COMPANY=Ромашка Стрит Фуд
CHECKLISTS_FILE=      # свой файл чек-листов, если не Ромашка

# ── пороги ───────────────────────────────────────────────────────────────────
PHOTOS_PER_RUN=2      # сколько случайных фото просить за раз
MIN_SECONDS=180       # быстрее — считаем формальным заполнением
REPEAT_FAIL=3         # столько провалов пункта за неделю = сломан процесс
CHECK_GAP=0.7         # ниже доли проверок — второй контур не работает
